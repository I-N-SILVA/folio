# ─── QLICO environment ───────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap, OG, manifest, auth redirect)
NEXT_PUBLIC_SITE_URL=https://qlico.app

# ── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the client.
# `SUPABASE_SERVICE_KEY` is also accepted for existing deployments; prefer this
# name, which is what Supabase itself calls it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AppSumo lifetime deal ─────────────────────────────────────────────────────
# API key from the AppSumo partner dashboard. Used to verify webhook signatures
# (HMAC-SHA256 of the raw request body) on /api/appsumo/webhook.
APPSUMO_API_KEY=your-appsumo-api-key

# ── AI (optional) ─────────────────────────────────────────────────────────────
# Google Generative AI key for AI-assisted SEO / copy (see lib/ai.ts)
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Abuse ─────────────────────────────────────────────────────────────────────
# Google Web Risk API key. When set, a published edition cannot be saved with a
# link to a known phishing or malware site (lib/link-safety.ts). First 100,000
# lookups a month are free. Without it, links are not checked.
GOOGLE_WEB_RISK_API_KEY=
# Where reader reports are emailed (/report). Defaults to the support address.
ABUSE_EMAIL=

# ── Support ───────────────────────────────────────────────────────────────────
# Shown on /help. Defaults to support@qlico.app.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ── Transactional email (optional) ────────────────────────────────────────────
# Notifies an author when a reader gives their email to a lead gate. Without
# both values set, no email is sent and nothing else changes (see lib/email.ts).
RESEND_API_KEY=
# The From address, e.g. "QLICO <hello@qlico.app>". Must be a verified sender.
EMAIL_FROM=
# Shared secret for the scheduled weekly digest (/api/cron/digest). The route
# fails closed without it — otherwise it would be an unauthenticated way to make
# the app email its own users. Vercel Cron sends it as `Authorization: Bearer`.
CRON_SECRET=
# Daily email budget, for a free email plan. Resend's free plan refuses past
# 100 a day / 3,000 a month: set 95 to stay under both. The weekly digest uses
# at most DIGEST_DAILY_LIMIT of it (default: total minus 20), so lead
# notifications always have room; authors it doesn't reach today get theirs on
# a later run. Leave both empty on a paid email plan.
EMAIL_DAILY_LIMIT=
DIGEST_DAILY_LIMIT=

# ── Stripe (subscription billing for the Pro plan — optional, separate from AppSumo) ─
# Billing UI/endpoints activate only when STRIPE_SECRET_KEY and the Pro price are set.
STRIPE_SECRET_KEY=
# Webhook signing secret for /api/billing/webhook (from the Stripe dashboard).
STRIPE_WEBHOOK_SECRET=
# Recurring price ID for the Pro subscription (price_...). Public so checkout can reference it.
NEXT_PUBLIC_STRIPE_PRICE_PRO=
# Optional yearly price for Pro (price_...). When set, the account page and the
# pricing card offer a yearly plan; without it Pro is monthly only. The amounts
# shown are PRO_PRICING in lib/plans.ts — keep them matching the Stripe Prices.
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=
# Charge sales tax / VAT through Stripe Tax. Set to "true" only after adding tax
# registrations in the Stripe dashboard (Tax → Registrations) — without them it
# collects addresses and charges nothing. Your Price objects also need a tax
# behaviour (inclusive or exclusive) set.
STRIPE_AUTOMATIC_TAX=
